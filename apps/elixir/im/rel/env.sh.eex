#!/bin/sh
# Release 启动前由 bin/im 自动 source（P9-01b）。
# 多副本时 Deployment 设 RELEASE_NODE_MODE=pod_ip，用 POD_IP 构造唯一节点名。

if [ -n "${POD_IP}" ] && [ "${RELEASE_NODE_MODE}" = "pod_ip" ]; then
  export RELEASE_NODE="im@${POD_IP}"
fi

# Erlang/OTP 原生 Linux perf 火焰图（BeamAsm +JPperf true）；默认关，排查性能时开启
# 注意：RELEASE_VM_ARGS 是 vm.args 文件路径，不能内联写 +JPperf
if [ "${IM_PERF_FLAMEGRAPH}" = "true" ]; then
  _base_vm_args="${RELEASE_ROOT}/releases/${RELEASE_VSN}/vm.args"
  _perf_vm_args="${RELEASE_TMP:-/tmp}/vm-perf.args"
  cat "${_base_vm_args}" > "${_perf_vm_args}"
  printf '\n+JPperf true\n' >> "${_perf_vm_args}"
  export RELEASE_VM_ARGS="${_perf_vm_args}"
fi
