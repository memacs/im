# 本地 / 联调环境变量示例（勿提交含真实密钥的 .env）
# 复制为 .env 后按需修改；.env 已在 .gitignore

# PostgreSQL（mise run pg-forward 默认端口）
DATABASE_URL=ecto://im:im_dev_only@127.0.0.1:15432/im_dev

# Phoenix
SECRET_KEY_BASE=dev_only_secret_key_base_minimum_64_characters_long_for_phoenix_xxxxxxxx
PHX_HOST=localhost
PHX_SERVER=true
PORT=4000

# Redis（mise run k8s-up 后 port-forward 或集群内 DNS）
REDIS_URL=redis://127.0.0.1:6379

# 联调 / 冒烟默认租户
APP_KEY=app_demo
